# ──────────────────────────────────────────
#  REQUIRED
# ──────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────
#  OPTIONAL – defaults shown
# ──────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash

# Set to path of yt-dlp binary for richer metadata extraction
# Download from: https://github.com/yt-dlp/yt-dlp/releases
YTDLP_PATH=

# Vector DB (memory = zero-setup local, chroma = persistent)
VECTOR_DB_PROVIDER=memory
CHROMA_URL=http://localhost:8000

# OpenAI (optional, only used if GOOGLE_API_KEY is not set)
OPENAI_API_KEY=
OPENAI_EMBEDDINGS=false
